generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String?           @unique
  emailVerified DateTime?
  image         String?
  password      String?
  birthdate     DateTime?
  accounts      Account[]
  goals         Goal[]
  groupsCreated Group[]           @relation("GroupCreator")
  groupsMember  GroupMember[]
  attendance    MatchAttendance[]
  matchPlayers  MatchPlayer[]
  sessions      Session[]
  logs          GroupLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Group {
  id                  String            @id @default(cuid())
  name                String
  description         String?
  sport               String?
  location            String?
  createdAt           DateTime          @default(now())
  createdBy           String
  nextMatch           DateTime?
  totalMatches        Int               @default(0)
  recurrenceDays      Int[]             @default([])
  recurrenceTime      String?
  recurrenceType      String?
  requiredPlayers     Int               @default(10)
  teamAName           String?           @default("Equipo A")
  teamBName           String?           @default("Equipo B")
  inviteToken         String?
  lastSortingCriteria Json?
  nextMatchId         String?           @unique
  creator             User              @relation("GroupCreator", fields: [createdBy], references: [id])
  nextMatchRef        Match?            @relation("NextMatch", fields: [nextMatchId], references: [id])
  invitations         GroupInvitation[]
  members             GroupMember[]
  matches             Match[]
  attendanceRecords   MatchAttendance[]
  logs                GroupLog[]
}

model GroupMember {
  id        String @id @default(cuid())
  role      String @default("MEMBER")
  groupId   String
  userId    String
  status    String @default("PENDING")
  starRating Int    @default(3)  // Nivel de habilidad del jugador (0-5)
  group     Group  @relation(fields: [groupId], references: [id])
  user      User   @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

model GroupInvitation {
  id        String   @id @default(cuid())
  groupId   String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  group     Group    @relation(fields: [groupId], references: [id])
}

model Match {
  id             String            @id @default(cuid())
  date           DateTime
  location       String
  groupId        String
  teamA          String
  teamB          String
  scoreA         Int               @default(0)
  scoreB         Int               @default(0)
  status         String            @default("PENDING")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  tbdPlayers     Json?             // Jugadores por determinar (TBD)
  sortCount      Int               @default(0)
  groupNextMatch Group?            @relation("NextMatch")
  group          Group             @relation(fields: [groupId], references: [id])
  attendance     MatchAttendance[]
  matchPlayers   MatchPlayer[]     @relation("MatchPlayers")
  goals          Goal[]
}

model MatchPlayer {
  id      String  @id @default(cuid())
  userId  String
  matchId String
  isTeamA Boolean
  match   Match   @relation("MatchPlayers", fields: [matchId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

model Goal {
  id      String  @id @default(cuid())
  matchId String
  userId  String
  isTeamA Boolean
  minute  Int?
  match   Match   @relation(fields: [matchId], references: [id])
  scorer  User    @relation(fields: [userId], references: [id])
}

model MatchAttendance {
  id          String   @id @default(cuid())
  userId      String
  groupId     String
  matchId     String?
  matchDate   DateTime
  status      String   @default("PENDING")
  playerRoles Json?    // Roles específicos del jugador para este partido
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  group       Group    @relation(fields: [groupId], references: [id])
  match       Match?   @relation(fields: [matchId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, matchId])
  @@index([groupId, matchDate])
}

model ShortUrl {
  id          String   @id @default(cuid())
  shortCode   String   @unique
  originalUrl String
  createdAt   DateTime @default(now())
  accessCount Int      @default(0)
}

model GroupLog {
  id          String   @id @default(cuid())
  groupId     String
  userId      String
  action      String
  details     Json?
  createdAt   DateTime @default(now())
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([groupId])
  @@index([userId])
}
