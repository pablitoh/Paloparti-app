{
  "name": "paloparti-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cp -f .env.local .env && next dev",
    "build": "next build",
    "start": "next start",
    "start:android": "cp -f .env.android .env && next start",
    "android:update": "npm run build && npx cap sync && cd android && ./gradlew installDebug && cd ..",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "android:prepare": "cp -f .env.android .env && NEXT_PUBLIC_PLATFORM=android NODE_ENV=production next build",
    "android:sync": "npx cap sync",
    "android:run": "npx cap run android",
    "android:dev": "npm run android:prepare && npm run android:sync && npm run android:run",
    "android:clean": "cd android && ./gradlew clean",
    "android:build": "cd android && ./gradlew assembleDebug",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
